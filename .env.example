# Заполните и сохраните как .env в корне проекта на сервере.
# Этот же файл читает docker-compose.production.yml (и для переменных
# окружения контейнеров, и для подстановки ${DOCKER_USERNAME} в образы).

DOCKER_USERNAME=your-dockerhub-username

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,your-server-ip,your-domain.example.org

USE_SQLITE=False
POSTGRES_DB=foodgram
POSTGRES_USER=foodgram_user
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
